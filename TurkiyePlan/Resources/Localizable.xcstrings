    "Eski yoksulluk=0 yer tutucuları bilinmeyen veri olarak ele alındı. Plan korundu; yoksulluk ağırlığı 0 yapıldı. Profil JSON dosyasını yükledikten sonra ağırlığı yeniden uygulayın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski yoksulluk=0 yer tutucuları bilinmeyen veri olarak ele alındı. Plan korundu; yoksulluk ağırlığı 0 yapıldı. Profil JSON dosyasını yükledikten sonra ağırlığı yeniden uygulayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy poverty zeros are unknown. Plan preserved; weight set to 0. Import profiles and apply a weight again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceros antiguos son desconocidos. Plan conservado; peso 0. Importe perfiles y aplique peso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeri precedenti sono ignoti. Piano conservato; peso 0. Importa profili e applica un peso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧贫困零值按未知处理。规划保留，权重为0。导入档案后重新应用权重。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने गरीबी शून्य अज्ञात हैं। योजना सुरक्षित; भार 0। प्रोफ़ाइल आयात कर भार लागू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصفار الفقر القديمة مجهولة. الخطة محفوظة والوزن 0. استورد الملفات ثم طبّق الوزن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciens zéros inconnus. Plan conservé ; poids 0. Importez des profils puis appliquez un poids."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরোনো দারিদ্র্য শূন্য অজানা। পরিকল্পনা অক্ষত; ওজন 0। প্রোফাইল এনে ওজন প্রয়োগ করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeros antigos são desconhecidos. Plano preservado; peso 0. Importe perfis e aplique peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые нули бедности неизвестны. План сохранён; вес 0. Импортируйте профили и примените вес."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرانے غربت صفر نامعلوم۔ منصوبہ برقرار؛ وزن 0۔ پروفائل درآمد کر کے وزن لگائیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
