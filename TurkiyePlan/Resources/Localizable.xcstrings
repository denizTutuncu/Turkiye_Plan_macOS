    "Açık = max(0, ceil(ihtiyaç duyan × hedef kapsam) − yeterli hizmet alan)": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık = max(0, ceil(ihtiyaç duyan × hedef kapsam) − yeterli hizmet alan)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gap = max(0, ceil(eligible × target coverage) − served)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brecha = max(0, ceil(elegibles × cobertura objetivo) − atendidos)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carenza = max(0, ceil(aventi diritto × copertura obiettivo) − serviti)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺口 = max(0, ceil(需求人数 × 目标覆盖率) − 已服务人数)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर = max(0, ceil(पात्र × लक्षित कवरेज) − सेवा प्राप्त)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفجوة = max(0, ceil(المستحقين × التغطية المستهدفة) − المخدومين)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déficit = max(0, ceil(éligibles × couverture cible) − desservis)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘাটতি = max(0, ceil(যোগ্য × লক্ষ্য আওতা) − পরিষেবাপ্রাপ্ত)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacuna = max(0, ceil(elegíveis × cobertura alvo) − atendidos)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дефицит = max(0, ceil(нуждающиеся × целевой охват) − обслуженные)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خلا = max(0, ceil(اہل × ہدف کوریج) − خدمت یافتہ)"
          }
        }
      },
      "generatesSymbol": false
    },
