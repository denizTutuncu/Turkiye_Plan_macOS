    "Nüfus gözlemi yüklenmemiş; 0 kişi olduğu anlamına gelmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüfus gözlemi yüklenmemiş; 0 kişi olduğu anlamına gelmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No population observation loaded; this does not mean zero people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin observación cargada; no significa cero personas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna osservazione caricata; non significa zero persone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未加载人口观测；不代表人口为零。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जनसंख्या अवलोकन लोड नहीं; अर्थ शून्य लोग नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحمّل بيانات السكان؛ لا يعني صفر أشخاص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune observation chargée ; cela ne signifie pas zéro habitant."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জনসংখ্যার পর্যবেক্ষণ নেই; মানে শূন্য মানুষ নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem observação carregada; não significa zero pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Население не загружено; это не значит ноль жителей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آبادی مشاہدہ لوڈ نہیں؛ اس کا مطلب صفر افراد نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
    "Nüfus gözlemleri ve hizmet ihtiyacı kayıtları ayrıdır. Nüfusun bilinmesi, sağlık ihtiyacı veya mevcut hizmet kapsamının bilindiği anlamına gelmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüfus gözlemleri ve hizmet ihtiyacı kayıtları ayrıdır. Nüfusun bilinmesi, sağlık ihtiyacı veya mevcut hizmet kapsamının bilindiği anlamına gelmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Population and service needs are separate. Knowing population does not establish healthcare demand or coverage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Población y necesidades son distintas. La población no determina demanda sanitaria ni cobertura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Popolazione e bisogni sono separati. La popolazione non determina domanda sanitaria o copertura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人口与服务需求分开。人口已知不代表医疗需求或覆盖已知。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जनसंख्या और मांग अलग हैं। जनसंख्या से स्वास्थ्य मांग या कवरेज पता नहीं चलता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكان واحتياجات الخدمات منفصلان. السكان لا يحددون الطلب الصحي أو التغطية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Population et besoins sont distincts. La population ne détermine pas besoins de santé ou couverture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জনসংখ্যা ও চাহিদা পৃথক। জনসংখ্যা জানা মানে স্বাস্থ্যচাহিদা বা আওতা জানা নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "População e necessidades são distintas. População não determina demanda de saúde ou cobertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Население и потребности различаются. Численность не определяет спрос на медицину и охват."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آبادی اور ضرورت الگ ہیں۔ آبادی جاننے سے طبی طلب یا کوریج معلوم نہیں۔"
          }
        }
      },
