    "Öncelik puanı = gereksinim × (1 + yoksulluk ağırlığı × yoksulluk oranı) ÷ mali kapasite endeksi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelik puanı = gereksinim × (1 + yoksulluk ağırlığı × yoksulluk oranı) ÷ mali kapasite endeksi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority score = requirement × (1 + poverty weight × poverty rate) ÷ fiscal capacity index"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioridad = necesidad × (1 + peso pobreza × tasa pobreza) ÷ índice fiscal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorità = fabbisogno × (1 + peso povertà × tasso povertà) ÷ indice fiscale"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先分数 = 资金需求 × (1 + 贫困权重 × 贫困率) ÷ 财政能力指数"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकता = ज़रूरत × (1 + गरीबी भार × गरीबी दर) ÷ वित्तीय क्षमता"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأولوية = الاحتياج × (1 + وزن الفقر × نسبة الفقر) ÷ مؤشر القدرة المالية"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorité = besoin × (1 + poids pauvreté × taux pauvreté) ÷ indice budgétaire"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অগ্রাধিকার = প্রয়োজন × (1 + দারিদ্র্য ওজন × হার) ÷ আর্থিক সক্ষমতা"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioridade = necessidade × (1 + peso pobreza × taxa pobreza) ÷ índice fiscal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритет = потребность × (1 + вес бедности × доля бедных) ÷ бюджетный индекс"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجیح = ضرورت × (1 + غربت وزن × غربت شرح) ÷ مالی صلاحیت"
          }
        }
      },
      "generatesSymbol": false
    },
