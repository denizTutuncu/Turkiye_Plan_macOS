    "Sorumlu kurum • saha ve izinler • satın alma • işe alım • bakım • çıktı doğrulama: henüz atanmadı.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorumlu kurum • saha ve izinler • satın alma • işe alım • bakım • çıktı doğrulama: henüz atanmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agency, site, permits, procurement, hiring, maintenance and outcome verification: unassigned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organismo, sitio, permisos, compras, contratación, mantenimiento y verificación: sin asignar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ente, sede, permessi, acquisti, personale, manutenzione e verifica: non assegnati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机构、场地、许可、采购、招聘、维护及成果核实：未指定。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्था, स्थल, अनुमति, खरीद, भर्ती, रखरखाव व परिणाम जाँच: तय नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهة والموقع والتراخيص والمشتريات والتوظيف والصيانة والتحقق: غير معينة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisme, site, permis, achats, recrutement, maintenance et vérification : non attribués."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্থা, স্থান, অনুমতি, ক্রয়, নিয়োগ, রক্ষণাবেক্ষণ ও ফল যাচাই: অনির্ধারিত।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Órgão, local, licenças, compras, contratação, manutenção e verificação: não atribuídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организация, участок, разрешения, закупки, найм, обслуживание и проверка: не назначены."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادارہ، جگہ، اجازت، خرید، بھرتی، دیکھ بھال اور نتائج جانچ: مقرر نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
