    "Eksik veri sıfır değildir. Sonuçlar yalnızca girilmiş ilçe–hizmet kayıtlarını kapsar.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik veri sıfır değildir. Sonuçlar yalnızca girilmiş ilçe–hizmet kayıtlarını kapsar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing data is not zero. Results cover only entered district–service records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos ausentes no son cero. Solo se incluyen registros introducidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati mancanti non sono zero. Risultati solo per i record inseriti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失不等于零。结果仅涵盖已录入的区县服务记录。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुम डेटा शून्य नहीं। परिणाम केवल दर्ज ज़िला-सेवा रिकॉर्ड के हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات المفقودة ليست صفرًا. النتائج للسجلات المدخلة فقط."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données manquantes ne sont pas zéro. Seules les fiches saisies sont couvertes."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুপস্থিত তথ্য শূন্য নয়। শুধু নথিভুক্ত রেকর্ডের ফল।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados ausentes não são zero. Resultados só dos registros inseridos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных не значит ноль. Результаты только для введённых записей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گم ڈیٹا صفر نہیں۔ نتائج صرف درج ضلع-خدمت ریکارڈ کے ہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
