        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone equivalenti con migliore acqua/fognature; non famiglie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供水／污水可及性改善的人口当量；非户数"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर जल/सीवेज पहुँच के व्यक्ति-समतुल्य; परिवार नहीं"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكافئ أشخاص بوصول مياه/صرف أفضل؛ ليس أسرًا"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équivalents-personnes avec meilleur accès eau/assainissement ; pas des ménages"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্নত পানি/নিষ্কাশনের ব্যক্তি-সমতুল্য; পরিবার নয়"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas equivalentes com melhor água/esgoto; não domicílios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эквивалент людей с улучшенной водой/канализацией; не домохозяйства"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہتر پانی/نکاسی رسائی کے فرد مساوی؛ گھرانے نہیں"
          }
        }
      },
      "generatesSymbol": false
    },
