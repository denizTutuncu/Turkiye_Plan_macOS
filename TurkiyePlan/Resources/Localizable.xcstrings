    "Yeni alanlardaki sıfırlar gözlem değildir. Kaynak girilmeden kayıt kabul edilmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni alanlardaki sıfırlar gözlem değildir. Kaynak girilmeden kayıt kabul edilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default zeros are not observations. A source is required before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceros iniciales no son observaciones. Se requiere fuente para guardar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli zeri iniziali non sono osservazioni. Serve una fonte per salvare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认零值不是观测。保存前须填写来源。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट शून्य अवलोकन नहीं। सहेजने से पहले स्रोत चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصفار الافتراضية ليست رصدًا. يلزم مصدر قبل الحفظ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zéros initiaux ne sont pas des observations. Une source est requise."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাথমিক শূন্য পর্যবেক্ষণ নয়। সংরক্ষণে উৎস চাই।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeros iniciais não são observações. Uma fonte é necessária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нули по умолчанию не являются наблюдениями. Нужен источник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدائی صفر مشاہدات نہیں۔ محفوظ کرنے سے پہلے ماخذ ضروری۔"
          }
        }
      },
      "generatesSymbol": false
    },
    "Yeni hizmet taslağı: yalnızca nüfus gözlemden doldurulur. Diğer alanlar ölçülmüş veri değildir; ihtiyaç ve maliyet kaynağı girilmelidir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni hizmet taslağı: yalnızca nüfus gözlemden doldurulur. Diğer alanlar ölçülmüş veri değildir; ihtiyaç ve maliyet kaynağı girilmelidir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New draft: only population is observed. Other fields are not measurements; provide demand and cost sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrador: solo población observada. Otros campos no son mediciones; indique fuentes de demanda y costes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozza: solo la popolazione è osservata. Fornisci fonti per fabbisogni e costi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新草稿：仅人口来自观测。其他字段并非测量；请提供需求及成本来源。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया मसौदा: केवल जनसंख्या अवलोकित। अन्य माप नहीं; मांग और लागत स्रोत दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسودة جديدة: السكان فقط مرصودون. الحقول الأخرى ليست قياسات؛ أضف مصادر الطلب والتكلفة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon : seule la population est observée. Fournissez les sources des besoins et coûts."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন খসড়ায় শুধু জনসংখ্যা পর্যবেক্ষিত। অন্যগুলো পরিমাপ নয়; চাহিদা ও খরচের উৎস দিন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunho: só população observada. Outros campos não são medições; indique fontes de demanda e custos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик: наблюдается лишь население. Прочие поля не измерены; укажите источники спроса и затрат."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا مسودہ: صرف آبادی مشاہدہ شدہ۔ دیگر پیمائش نہیں؛ طلب اور لاگت کے ماخذ دیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
