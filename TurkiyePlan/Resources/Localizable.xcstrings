    "Tüm hizmetler aynı ilçe profilini kullanır. Düzenleme üstteki İlçe yoksulluk profili bölümündedir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hizmetler aynı ilçe profilini kullanır. Düzenleme üstteki İlçe yoksulluk profili bölümündedir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All services use the same district profile. Edit it in District poverty profile above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los servicios usan el mismo perfil. Edítelo arriba en Perfil de pobreza del distrito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i servizi usano lo stesso profilo. Modificalo nel profilo del distretto sopra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有服务使用同一区县档案。请在上方区县贫困档案编辑。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी सेवाएँ एक ज़िला प्रोफ़ाइल उपयोग करती हैं। ऊपर गरीबी प्रोफ़ाइल में बदलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الخدمات ملف القضاء نفسه. عدّله في ملف الفقر أعلاه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les services utilisent le même profil. Modifiez-le dans le profil de pauvreté ci-dessus."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব পরিষেবা একই প্রোফাইল ব্যবহার করে। উপরের দারিদ্র্য প্রোফাইলে বদলান।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os serviços usam o mesmo perfil. Edite no perfil de pobreza acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все услуги используют один профиль района. Изменяйте его в профиле бедности выше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام خدمات ضلع کی ایک پروفائل استعمال کرتی ہیں۔ اوپر غربت پروفائل میں بدلیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
