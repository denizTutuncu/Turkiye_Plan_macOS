    "Yerel coğrafya deposu eksik. Mevcut depo korunuyor; otomatik olarak üzerine yazılmayacak.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel coğrafya deposu eksik. Mevcut depo korunuyor; otomatik olarak üzerine yazılmayacak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local geography is missing. Existing storage is preserved and will not be overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta geografía local. Almacén conservado sin sobrescribir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Geografia locale mancante. Archivio conservato senza sovrascrittura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少本地地理。现有存储保留，不会覆盖。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय भूगोल गुम। मौजूदा संग्रह सुरक्षित, ऊपर नहीं लिखा जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجغرافيا المحلية مفقودة. التخزين محفوظ ولن يُستبدل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géographie locale manquante. Stockage conservé sans écrasement."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় ভূগোল নেই। বর্তমান সংরক্ষণ অক্ষত, প্রতিস্থাপিত হবে না।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Geografia local ausente. Armazenamento preservado sem sobrescrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет локальной географии. Хранилище сохранено и не перезаписывается."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی جغرافیہ نہیں۔ ذخیرہ برقرار اور تبدیل نہیں ہوگا۔"
          }
        }
      },
      "generatesSymbol": false
    },
