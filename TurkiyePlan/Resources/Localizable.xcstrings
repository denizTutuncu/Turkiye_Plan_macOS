    "Mevcut maliyet kayıtlarının yılı farklı. Önce fiyat bazını uyumlu hale getirin veya ayrı senaryo içe aktarın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut maliyet kayıtlarının yılı farklı. Önce fiyat bazını uyumlu hale getirin veya ayrı senaryo içe aktarın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost records use another year. Align price bases or import a separate scenario."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los costes usan otro año. Alinee precios o importe otro escenario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I costi usano un altro anno. Allinea i prezzi o importa un altro scenario."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成本年份不同。统一价格基准或导入其他情景。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लागत वर्ष अलग। मूल्य आधार मिलाएँ या अलग परिदृश्य आयात करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة التكاليف مختلفة. وحّد الأسعار أو استورد سيناريو منفصلًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Année des coûts différente. Harmonisez les prix ou importez un scénario distinct."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খরচের বছর আলাদা। মূল্যভিত্তি মেলান বা অন্য দৃশ্যকল্প আনুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano dos custos diferente. Alinhe preços ou importe outro cenário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Год затрат отличается. Согласуйте цены или импортируйте отдельный сценарий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاگت کا سال الگ۔ قیمت بنیاد ملائیں یا الگ منظرنامہ درآمد کریں۔"
          }
        }
      },
      "generatesSymbol": false
    },
    "Mevcut model, ayrılmış bir bütçeyi dağıtır. Gelir tahmini, borç sürdürülebilirliği ve makroekonomik etkiler bu sürümde hesaplanmaz. Tasarruflar veya sosyal faydalar bütçe geliri olarak eklenmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut model, ayrılmış bir bütçeyi dağıtır. Gelir tahmini, borç sürdürülebilirliği ve makroekonomik etkiler bu sürümde hesaplanmaz. Tasarruflar veya sosyal faydalar bütçe geliri olarak eklenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model allocates a specified budget. It does not forecast revenue, debt sustainability or macroeconomic effects. Savings and social benefits are not added as revenue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparte un presupuesto. No prevé ingresos, sostenibilidad de deuda ni efectos macroeconómicos. Ahorros y beneficios sociales no son ingresos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuisce un budget. Non prevede entrate, sostenibilità del debito o effetti macroeconomici. Risparmi e benefici sociali non sono entrate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型分配既定预算。不预测收入、债务可持续性或宏观影响。节约及社会效益不计为预算收入。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तय बजट बाँटता है। राजस्व, ऋण स्थिरता या व्यापक आर्थिक प्रभाव नहीं आँकता। बचत और सामाजिक लाभ राजस्व नहीं हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوزع ميزانية محددة. لا يتنبأ بالإيرادات أو استدامة الدين أو الآثار الكلية. الوفورات والمنافع الاجتماعية لا تضاف كإيراد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle répartit un budget défini. Il ne prévoit ni recettes, ni dette soutenable, ni effets macroéconomiques. Économies et bénéfices sociaux ne sont pas des recettes."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল নির্দিষ্ট বাজেট বণ্টন করে। রাজস্ব, ঋণের স্থায়িত্ব বা সামষ্টিক প্রভাব অনুমান করে না। সাশ্রয় ও সামাজিক লাভ রাজস্ব নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribui um orçamento definido. Não prevê receita, sustentabilidade da dívida ou efeitos macroeconômicos. Economias e benefícios sociais não são receita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель распределяет заданный бюджет. Не прогнозирует доходы, устойчивость долга и макроэффекты. Экономия и социальные выгоды не добавляются в доход."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل مقررہ بجٹ بانٹتا ہے۔ آمدنی، قرض کی پائیداری یا معاشی اثرات کی پیش گوئی نہیں۔ بچت اور سماجی فوائد آمدنی نہیں ہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
