    "Yerel kayıt ve JSON dışa aktarımı ayrıdır. İçe aktardığınız kaynak dosya değiştirilmez. JSON dışa aktarımı taşınabilir yedek oluşturur.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kayıt ve JSON dışa aktarımı ayrıdır. İçe aktardığınız kaynak dosya değiştirilmez. JSON dışa aktarımı taşınabilir yedek oluşturur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local saving and JSON export are separate. Imported files stay unchanged. Export JSON for a portable backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar y exportar JSON son distintos. El original no cambia. Exporte JSON para respaldo portátil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio ed export JSON sono separati. L’originale resta invariato. Esporta JSON per un backup portatile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地保存与JSON导出独立。导入源文件不变。导出JSON可作便携备份。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय सहेजना और JSON निर्यात अलग हैं। मूल फ़ाइल नहीं बदलती। बैकअप हेतु JSON निर्यात करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفظ المحلي وتصدير JSON منفصلان. الأصل لا يتغير. صدّر JSON لنسخة احتياطية محمولة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement local et export JSON sont distincts. L’original reste inchangé. Exportez JSON pour une sauvegarde portable."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় সংরক্ষণ ও JSON রপ্তানি পৃথক। মূল ফাইল বদলায় না। ব্যাকআপে JSON রপ্তানি করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar e exportar JSON são separados. O original não muda. Exporte JSON para backup portátil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение и экспорт JSON раздельны. Исходный файл не меняется. Экспортируйте JSON для резервной копии."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی محفوظ اور JSON برآمد الگ ہیں۔ اصل فائل نہیں بدلتی۔ بیک اپ کے لیے JSON برآمد کریں۔"
          }
        }
      },
      "generatesSymbol": false
    },
