    "İçe aktarılan senaryo ve Kaydet / Uygula işlemleri yerel veritabanına kaydedilir. Formda henüz uygulanmamış değişiklikler kalıcı değildir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan senaryo ve Kaydet / Uygula işlemleri yerel veritabanına kaydedilir. Formda henüz uygulanmamış değişiklikler kalıcı değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports and Save / Apply persist locally. Unapplied form edits are not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar y Guardar / Aplicar persisten localmente. Los cambios sin aplicar no se guardan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazioni e Salva / Applica sono locali. Le modifiche non applicate non vengono salvate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入及保存／应用会写入本地。未应用的表单修改不会保存。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात और सहेजें / लागू करें स्थानीय हैं। लागू न किए बदलाव नहीं सहेजे जाते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيراد والحفظ / التطبيق يُحفظ محليًا. التعديلات غير المطبقة لا تُحفظ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports et Enregistrer / Appliquer sont locaux. Les modifications non appliquées ne sont pas enregistrées."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমদানি ও সংরক্ষণ / প্রয়োগ স্থানীয়। প্রয়োগ না করা পরিবর্তন সংরক্ষিত হয় না।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importações e Salvar / Aplicar persistem localmente. Alterações não aplicadas não são salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт и «Сохранить / Применить» сохраняются локально. Неприменённые изменения не сохраняются."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد اور محفوظ / لاگو مقامی محفوظ ہوتے ہیں۔ غیر لاگو تبدیلیاں محفوظ نہیں ہوتیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
