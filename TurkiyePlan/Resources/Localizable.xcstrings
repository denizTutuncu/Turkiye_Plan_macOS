    "Gözlem olarak işaretlemek, uygulamanın kaynağı bağımsız doğruladığı anlamına gelmez. Harcama veya SEGE skoru doğrudan bir yoksulluk yüzdesi değildir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlem olarak işaretlemek, uygulamanın kaynağı bağımsız doğruladığı anlamına gelmez. Harcama veya SEGE skoru doğrudan bir yoksulluk yüzdesi değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed status does not independently verify a source. Spending or SEGE scores are not poverty percentages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado observado no verifica la fuente. Gasto o SEGE no son porcentajes de pobreza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato osservato non verifica la fonte. Spesa o SEGE non sono percentuali di povertà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观测状态不代表独立核实来源。支出或SEGE评分并非贫困率。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवलोकित स्थिति स्रोत सत्यापित नहीं करती। खर्च या SEGE गरीबी प्रतिशत नहीं हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة الرصد لا تتحقق من المصدر. الإنفاق وSEGE ليسا نسب فقر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statut observé ne vérifie pas la source. Dépenses et SEGE ne sont pas des taux de pauvreté."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যবেক্ষিত অবস্থা উৎস যাচাই নয়। ব্যয় বা SEGE দারিদ্র্যের শতাংশ নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado observado não verifica a fonte. Despesa ou SEGE não são percentuais de pobreza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус наблюдения не подтверждает источник. Расходы и SEGE не являются долей бедных."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاہدہ شدہ حیثیت ماخذ کی تصدیق نہیں۔ خرچ یا SEGE غربت کی شرح نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
