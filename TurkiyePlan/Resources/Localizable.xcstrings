    "Kaynak / veri seti / yöntem alanını doldurun. Nüfus kaynağı tek başına hizmet ihtiyacını ve maliyetini doğrulamaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak / veri seti / yöntem alanını doldurun. Nüfus kaynağı tek başına hizmet ihtiyacını ve maliyetini doğrulamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide source / dataset / method. Population alone does not verify service demand or costs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique fuente / datos / método. La población no verifica demanda ni costes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica fonte / dati / metodo. La popolazione non verifica fabbisogni o costi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写来源／数据集／方法。仅人口不能核实服务需求和成本。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत / डेटा / विधि दें। जनसंख्या से मांग या लागत सत्यापित नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المصدر / البيانات / الطريقة. السكان وحدهم لا يثبتون الطلب أو التكلفة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez source / données / méthode. La population ne vérifie pas besoins ou coûts."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উৎস / তথ্য / পদ্ধতি দিন। জনসংখ্যা একা চাহিদা বা খরচ যাচাই নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe fonte / dados / método. População não verifica demanda ou custos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите источник / данные / метод. Население не подтверждает спрос и затраты."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماخذ / ڈیٹا / طریقہ دیں۔ آبادی اکیلی طلب یا لاگت کی تصدیق نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
