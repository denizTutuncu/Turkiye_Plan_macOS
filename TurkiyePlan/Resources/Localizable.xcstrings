    "İller ve İlçeler sekmesinden kayıt ekleyin veya Veri ve Kaynaklar sekmesinden JSON içe aktarın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İller ve İlçeler sekmesinden kayıt ekleyin veya Veri ve Kaynaklar sekmesinden JSON içe aktarın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add records in Provinces and Districts, or import JSON in Data and Sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada registros en Provincias y distritos, o importe JSON en Datos y fuentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi record in Province e distretti o importa JSON in Dati e fonti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在省与区县添加记录，或在数据与来源导入JSON。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रांत और ज़िले में रिकॉर्ड जोड़ें या डेटा और स्रोत में JSON आयात करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف سجلات في الولايات والأقضية أو استورد JSON من البيانات والمصادر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des fiches dans Provinces et districts ou importez JSON dans Données et sources."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রদেশ ও জেলায় রেকর্ড যোগ বা তথ্য ও উৎসে JSON আনুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione registros em Províncias e distritos ou importe JSON em Dados e fontes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте записи в провинциях и районах или импортируйте JSON в данных и источниках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صوبے اور اضلاع میں ریکارڈ یا ڈیٹا اور ماخذ میں JSON درآمد کریں۔"
          }
