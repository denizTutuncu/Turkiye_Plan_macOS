    "Ağırlıklandırmada aynı yoksulluk tanımı ve referans yılı kullanılmalı. Bölgesel ve ulusal eşikler karıştırılamaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlıklandırmada aynı yoksulluk tanımı ve referans yılı kullanılmalı. Bölgesel ve ulusal eşikler karıştırılamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same poverty definition and year. Do not mix regional and national thresholds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use igual definición y año. No mezcle umbrales regionales y nacionales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa stessa definizione e anno. Non mescolare soglie regionali e nazionali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "须使用同一贫困定义和年份。勿混用区域和全国门槛。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान गरीबी परिभाषा और वर्ष रखें। क्षेत्रीय और राष्ट्रीय सीमाएँ न मिलाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تعريف فقر وسنة موحدين. لا تخلط العتبات الإقليمية والوطنية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même définition et année requises. Ne mélangez pas seuils régionaux et nationaux."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই সংজ্ঞা ও বছর দিন। আঞ্চলিক ও জাতীয় সীমা মেশাবেন না।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use mesma definição e ano. Não misture limites regionais e nacionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны единое определение и год. Не смешивайте региональные и национальные пороги."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یکساں تعریف اور سال رکھیں۔ علاقائی اور قومی حدیں نہ ملائیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
