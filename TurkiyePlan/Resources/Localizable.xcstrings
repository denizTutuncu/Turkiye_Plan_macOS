    "Birim tahmini = açık × tahsis ÷ gereksinim. Kesirli tahmin bir inşaat veya satın alma taahhüdü değildir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birim tahmini = açık × tahsis ÷ gereksinim. Kesirli tahmin bir inşaat veya satın alma taahhüdü değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated units = gap × allocation ÷ requirement. Fractions are not construction or purchase commitments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades estimadas = brecha × asignación ÷ necesidad. Las fracciones no son compromisos de obra o compra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unità stimate = carenza × assegnazione ÷ fabbisogno. Le frazioni non sono impegni di costruzione o acquisto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估计单位数 = 缺口 × 分配额 ÷ 需求。小数并非建设或采购承诺。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित इकाइयाँ = अंतर × आवंटन ÷ ज़रूरत। भिन्न निर्माण या खरीद के वादे नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوحدات المقدرة = الفجوة × التخصيص ÷ الاحتياج. الكسور ليست التزامات بناء أو شراء."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unités estimées = déficit × allocation ÷ besoin. Les fractions ne sont pas des engagements de construction ou d’achat."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক একক = ঘাটতি × বরাদ্দ ÷ প্রয়োজন। ভগ্নাংশ নির্মাণ বা ক্রয়ের প্রতিশ্রুতি নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidades estimadas = lacuna × alocação ÷ necessidade. Frações não são compromissos de construção ou compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка единиц = дефицит × распределение ÷ потребность. Дроби не являются обязательствами строительства или закупки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تخمینی اکائیاں = خلا × تخصیص ÷ ضرورت۔ کسری اعداد تعمیر یا خرید کے وعدے نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
