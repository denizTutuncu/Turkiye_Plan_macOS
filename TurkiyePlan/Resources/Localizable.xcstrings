    "Önce veriyi doğrulayın; sonra hizmet açığını, maliyeti ve finansmanı birlikte değerlendirin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce veriyi doğrulayın; sonra hizmet açığını, maliyeti ve finansmanı birlikte değerlendirin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate data, then assess service gaps, costs and funding together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide datos y evalúe brechas, costes y financiación juntos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica i dati e valuta carenze, costi e fondi insieme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先核实数据，再综合评估服务缺口、成本与资金。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा जाँचें, फिर सेवा अंतर, लागत और वित्त साथ देखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من البيانات ثم قيّم الفجوات والتكاليف والتمويل معًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez les données, puis évaluez besoins, coûts et financement ensemble."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তথ্য যাচাই করে ঘাটতি, খরচ ও অর্থায়ন একসঙ্গে দেখুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide dados e avalie lacunas, custos e financiamento juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте данные, оцените дефицит услуг, затраты и средства вместе."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیٹا جانچیں، پھر خلا، لاگت اور مالی وسائل ساتھ دیکھیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
    "Önce çalışma alanı yüklenmeli.": {
