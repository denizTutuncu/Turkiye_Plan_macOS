    "Gereksinim = açık × (birim yatırım + yıllık işletme × yıl) × maliyet endeksi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereksinim = açık × (birim yatırım + yıllık işletme × yıl) × maliyet endeksi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requirement = gap × (capital/unit + annual operating/unit × years) × cost index"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesidad = brecha × (inversión/unidad + operación anual/unidad × años) × índice de coste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fabbisogno = carenza × (investimento/unità + gestione annua/unità × anni) × indice di costo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资金需求 = 缺口 × (单位投资 + 单位年度运营 × 年数) × 成本指数"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरत = अंतर × (इकाई पूंजी + वार्षिक इकाई संचालन × वर्ष) × लागत सूचकांक"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتياج = الفجوة × (استثمار الوحدة + تشغيل سنوي للوحدة × السنوات) × مؤشر التكلفة"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besoin = déficit × (investissement/unité + fonctionnement annuel/unité × années) × indice de coût"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রয়োজন = ঘাটতি × (একক বিনিয়োগ + একক বার্ষিক পরিচালন × বছর) × খরচ সূচক"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessidade = lacuna × (investimento/unidade + operação anual/unidade × anos) × índice de custo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребность = дефицит × (капзатраты/ед. + годовые расходы/ед. × годы) × индекс затрат"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ضرورت = خلا × (فی اکائی سرمایہ + سالانہ فی اکائی عمل × سال) × لاگت اشاریہ"
          }
        }
      },
      "generatesSymbol": false
    },
