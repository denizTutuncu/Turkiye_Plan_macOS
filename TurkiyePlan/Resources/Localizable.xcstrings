    "İlçe yoksulluk profili yok. Eski kayıttaki 0, yoksulluğun sıfır olduğu anlamına gelmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlçe yoksulluk profili yok. Eski kayıttaki 0, yoksulluğun sıfır olduğu anlamına gelmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No district poverty profile. A legacy zero does not mean no poverty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin perfil de pobreza. Un cero antiguo no significa ausencia de pobreza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun profilo. Uno zero precedente non indica assenza di povertà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无贫困档案。旧零值不代表无贫困。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गरीबी प्रोफ़ाइल नहीं। पुराना शून्य गरीबी न होने का प्रमाण नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف فقر. الصفر القديم لا يعني انعدام الفقر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil. Un ancien zéro ne signifie pas absence de pauvreté."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দারিদ্র্য প্রোফাইল নেই। পুরোনো শূন্য মানে দারিদ্র্য নেই নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem perfil. Um zero antigo não significa ausência de pobreza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет профиля. Старый ноль не означает отсутствия бедности."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غربت پروفائل نہیں۔ پرانا صفر غربت نہ ہونے کا مطلب نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
