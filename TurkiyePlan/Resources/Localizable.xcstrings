    ". Fiyat bazlarını uyumlu hale getirin. Nüfus gözleminin yılı farklı olabilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Fiyat bazlarını uyumlu hale getirin. Nüfus gözleminin yılı farklı olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". Align price bases. Population may use another year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ". Alinee precios. Población puede ser de otro año."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ". Allinea i prezzi. Popolazione può usare altro anno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。统一价格基准。人口年份可不同。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "। मूल्य आधार मिलाएँ। जनसंख्या वर्ष अलग हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ". وحّد الأسعار. قد تختلف سنة السكان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Harmonisez les prix. L’année de population peut différer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "। মূল্যভিত্তি মেলান। জনসংখ্যার বছর আলাদা হতে পারে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": ". Alinhe preços. População pode usar outro ano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ". Согласуйте цены. Год населения может отличаться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "۔ قیمت بنیاد ملائیں۔ آبادی کا سال الگ ہو سکتا ہے۔"
          }
        }
      },
      "generatesSymbol": false
    },
    ". Yoksulluk profili yükleyin veya ağırlığı 0 yapın; bilinmeyen oran 0 kabul edilmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Yoksulluk profili yükleyin veya ağırlığı 0 yapın; bilinmeyen oran 0 kabul edilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". Import profiles or set weight to 0; unknown is not zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ". Importe perfiles o use peso 0; desconocido no es cero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ". Importa profili o imposta peso 0; ignoto non è zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。导入档案或将权重设为0；未知不等于零。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "। प्रोफ़ाइल आयात या भार 0 करें; अज्ञात शून्य नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ". استورد الملفات أو اجعل الوزن 0؛ المجهول ليس صفرًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Importez des profils ou mettez le poids à 0 ; inconnu n’est pas zéro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "। প্রোফাইল আনুন বা ওজন 0 করুন; অজানা শূন্য নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": ". Importe perfis ou use peso 0; desconhecido não é zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ". Импортируйте профили или задайте вес 0; неизвестное не равно нулю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "۔ پروفائل درآمد یا وزن 0 کریں؛ نامعلوم صفر نہیں۔"
          }
        }
      },
      "generatesSymbol": false
    },
